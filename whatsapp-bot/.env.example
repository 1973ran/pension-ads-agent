# מפתח Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta for Developers → האפליקציה שלך → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# סיסמה שתבחר בעצמך ותזין גם בהגדרות ה-Webhook ב-Meta
WHATSAPP_VERIFY_TOKEN=
# App Settings → Basic → App Secret
WHATSAPP_APP_SECRET=

# המספרים שמורשים לדבר עם הסוכן, בלי + ובלי 0 בהתחלה, מופרדים בפסיקים
ALLOWED_NUMBERS=972501234567

PORT=3000
# CLAUDE_MODEL=claude-opus-5
